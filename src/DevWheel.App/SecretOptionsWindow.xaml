<Window x:Class="DevWheel.App.SecretOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Random secret" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStyle="ToolWindow" Topmost="True" ShowInTaskbar="False">
    <StackPanel Margin="16" Width="280">
        <TextBlock FontWeight="SemiBold" Text="Length" />
        <StackPanel Margin="0,4,0,12" Orientation="Horizontal">
            <RadioButton x:Name="Bytes16" Content="16 bytes" Margin="0,0,14,0" />
            <RadioButton x:Name="Bytes32" Content="32 bytes" Margin="0,0,14,0" />
            <RadioButton x:Name="Bytes64" Content="64 bytes" />
        </StackPanel>
        <TextBlock FontWeight="SemiBold" Text="Format" />
        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
            <RadioButton x:Name="FormatHex" Content="Hex" Margin="0,0,14,0" />
            <RadioButton x:Name="FormatBase64" Content="Base64" />
        </StackPanel>
        <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Content="Generate" IsDefault="True" Click="Ok_Click" Style="{StaticResource DialogButton}" />
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
        </StackPanel>
    </StackPanel>
</Window>
