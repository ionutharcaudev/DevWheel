<Window x:Class="DevWheel.App.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevWheel" Width="600" Height="460" MinWidth="320" MinHeight="200"
        WindowStyle="ToolWindow" Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="12">
        <StackPanel Margin="0,10,0,0" HorizontalAlignment="Right" DockPanel.Dock="Bottom" Orientation="Horizontal">
            <Button Content="Copy" Click="Copy_Click" Style="{StaticResource DialogButton}" />
            <Button Content="Close" IsCancel="True" IsDefault="True" Click="Close_Click" Style="{StaticResource DialogButton}" />
        </StackPanel>
        <TextBox x:Name="ContentBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Padding="6"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
