<Window x:Class="DevWheel.App.PasswordOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStyle="ToolWindow" Topmost="True" ShowInTaskbar="False">
    <StackPanel Margin="16" Width="280">
        <StackPanel Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Length" />
            <TextBox x:Name="LengthBox" Width="60" Margin="10,0,0,0" Padding="3,2" />
            <TextBlock x:Name="RangeText" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#666" />
        </StackPanel>
        <CheckBox x:Name="UpperBox" Margin="0,12,0,0" Content="Uppercase A-Z" />
        <CheckBox x:Name="LowerBox" Margin="0,4,0,0" Content="Lowercase a-z" />
        <CheckBox x:Name="DigitsBox" Margin="0,4,0,0" Content="Digits 0-9" />
        <CheckBox x:Name="SymbolsBox" Margin="0,4,0,0" Content="Symbols !#$%..." />
        <TextBlock x:Name="ErrorText" Margin="0,8,0,0" Foreground="#C42B1C" TextWrapping="Wrap" />
        <StackPanel Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Content="Generate" IsDefault="True" Click="Ok_Click" Style="{StaticResource DialogButton}" />
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
        </StackPanel>
    </StackPanel>
</Window>
